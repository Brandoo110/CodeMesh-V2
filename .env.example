# ────────────────────────────────────────────────
# 国内模型 API Key（生产主力 —— 满足合规）
# ────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
VOLC_API_KEY=

# ────────────────────────────────────────────────
# Gemini（仅学习 / 演示用；生产上境内合规场景请移除）
# 只填 GEMINI_API_KEY 也能跑通全套：
#   router/planner 会自动用 Gemini；
#   harness 在某家国内 key 缺席时透明降级到 Gemini。
# ────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ────────────────────────────────────────────────
# Langfuse 可观测性（可选；不填就静默关掉）
# ────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
